{
  "name": "@tower1229/stella-core",
  "version": "0.1.0-alpha.0",
  "description": "Stella 3.0 cognitive runtime plugin for OpenClaw",
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "typebox": "1.3.16",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}

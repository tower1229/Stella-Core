{
  "name": "@tower1229/stella-core",
  "version": "0.1.0-alpha.0",
  "description": "Stella 3.0 cognitive runtime plugin for OpenClaw",
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/compile.mjs build",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:schemas": "node scripts/check-schemas.mjs",
    "test": "node scripts/compile.mjs test && node --test .test-dist/tests/*.test.js",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "npm run check && npm run check:schemas && npm run build && npm test && npm run test:package"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.5",
    "typebox": "1.3.16",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "7.7.1",
    "openclaw": "2026.8.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    }
  }
}

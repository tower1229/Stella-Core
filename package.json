{
  "name": "@tower1229/stella-core",
  "version": "0.1.0-alpha.0",
  "description": "Source-aware work-brief plugin alongside native OpenClaw memory and context",
  "type": "module",
  "main": "./dist/src/ordinary-plugin.js",
  "types": "./dist/src/ordinary-plugin.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "schemas",
    "skills",
    "README.md",
    "evaluation/praxis-social.synthetic.json",
    "docs/EXPERIMENTAL-OWNER-CHAT.md",
    "docs/WEBCHAT-DEVICE-OWNER.md",
    "docs/EXPLICIT-SNAPSHOT-IMPORT.md",
    "docs/CHECKPOINT-WORK-SUPPLY.md",
    "docs/CHECKPOINT-UNDERSTANDING-SUPPLY.md",
    "docs/CHECKPOINT-CORRECTION-WRITER.md",
    "docs/MAIN-DEBUG-INSTALL.md",
    "docs/CANDIDATE-WORK-BRIEF.md"
  ],
  "scripts": {
    "build": "node scripts/compile.mjs build",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:schemas": "node scripts/check-schemas.mjs",
    "test": "node scripts/run-workspace-tests.mjs",
    "test:host-archive": "node scripts/compile.mjs build && node scripts/compile.mjs test && node scripts/probe-archive-retention.mjs",
    "test:package": "node scripts/package-smoke.mjs --dreaming-disabled",
    "recover:private": "npm run build --silent && node scripts/run-private-recovery.mjs",
    "praxis:private": "npm run build --silent && node scripts/run-private-praxis-loop.mjs",
    "evaluate:praxis": "npm run build --silent && node scripts/run-praxis-evaluation.mjs",
    "prepare:evaluation-source": "node scripts/compile.mjs build && node scripts/compile.mjs test && node scripts/prepare-public-evaluation-source.mjs",
    "candidate": "npm run build --silent && node scripts/create-alpha-candidate.mjs",
    "stella:activate": "npm run build --silent && node scripts/stella-activate.mjs",
    "verify": "npm run test:package",
    "verify:dreaming-boundary": "node scripts/verify-dreaming-boundary.mjs",
    "verify:experimental": "node scripts/package-experimental-owner-chat.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.5",
    "typebox": "1.3.16",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "7.7.1",
    "openclaw": "2026.10.8",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.7"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/ordinary-plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.7",
      "minGatewayVersion": "2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.8",
      "pluginSdkVersion": "2026.10.8"
    }
  }
}

{
  "id": "stella-core",
  "name": "Stella Core",
  "description": "Ordinary work-brief candidate plugin; native memory/context retained, publisher off",
  "contracts": {
    "tools": [
      "stella_status",
      "stella_author_intent_candidate"
    ]
  },
  "toolMetadata": {
    "stella_status": {
      "profiles": [
        "coding"
      ]
    },
    "stella_author_intent_candidate": {
      "profiles": [
        "coding"
      ]
    }
  },
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": [
      "openclaw"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$",
        "default": "main"
      },
      "publisher": {
        "type": "boolean",
        "const": false,
        "default": false
      }
    }
  }
}

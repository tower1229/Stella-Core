{
  "id": "stella-core",
  "name": "Stella Core",
  "description": "Ordinary work-brief candidate plugin; native memory/context retained, publisher off",
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "stella_status",
      "stella_author_intent_candidate",
      "stella_work_brief",
      "stella_source_read"
    ]
  },
  "toolMetadata": {
    "stella_status": {
      "profiles": [
        "coding"
      ]
    },
    "stella_author_intent_candidate": {
      "profiles": [
        "coding"
      ]
    },
    "stella_work_brief": {
      "profiles": [
        "coding"
      ]
    },
    "stella_source_read": {
      "profiles": ["coding"]
    }
  },
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": [
      "openclaw"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$",
        "default": "main"
      },
      "publisher": {
        "type": "boolean",
        "const": false,
        "default": false
      },
      "candidateDraftsRoot": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Optional dedicated synthetic-debug Git repository; explicit initialization marker required. No legacy or private source repository."
      },
      "sourceRead": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "manifestPath", "revision"],
        "properties": {
          "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "manifestPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        },
        "description": "Explicit selected clean Git source and manifest; this selects data only, never grants source/processing access. Default entry has no admission issuer and fails closed."
      }
    }
  }
}

diff --git a/src/ordinary-plugin.ts b/src/ordinary-plugin.ts
new file mode 100644
index 00000000..1983f21a
--- /dev/null
+++ b/src/ordinary-plugin.ts
@@ -0,0 +1,99 @@
+import { definePluginEntry, type OpenClawPluginToolContext } from "openclaw/plugin-sdk/plugin-entry";
+import { Type } from "typebox";
+import { isRecord } from "./shared/type-guards.js";
+
+export const CANDIDATE_TOOL = "stella_author_intent_candidate";
+export const STATUS_TOOL = "stella_status";
+const text = () => Type.String({ minLength: 1, maxLength: 4000 });
+const list = () => Type.Array(text(), { maxItems: 16 });
+export const CANDIDATE_PARAMETERS = Type.Object({
+  topic: text(),
+  interpretation: text(),
+  proposedPremises: list(),
+  openQuestions: list(),
+  evidenceReferences: list(),
+}, { additionalProperties: false });
+
+type Proposal = {
+  topic: string; interpretation: string; proposedPremises: string[];
+  openQuestions: string[]; evidenceReferences: string[];
+};
+const keys = ["topic", "interpretation", "proposedPremises", "openQuestions", "evidenceReferences"];
+function validText(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0 && value.length <= 4000;
+}
+function validList(value: unknown): value is string[] {
+  return Array.isArray(value) && value.length <= 16 && value.every(validText);
+}
+export function parseProposal(value: unknown): Proposal {
+  if (!isRecord(value) || Object.getPrototypeOf(value) !== Object.prototype ||
+      Object.keys(value).length !== keys.length || !keys.every(key => Object.hasOwn(value, key)) ||
+      !validText(value.topic) || !validText(value.interpretation) ||
+      !validList(value.proposedPremises) || !validList(value.openQuestions) || !validList(value.evidenceReferences)) {
+    throw new Error("stella_candidate_arguments_invalid");
+  }
+  return structuredClone(value) as Proposal;
+}
+
+export function parseOrdinaryConfig(value: unknown): { agentId: string; publisher: false } {
+  const config = value ?? {};
+  if (!isRecord(config) || Object.keys(config).some(key => key !== "agentId" && key !== "publisher") ||
+      (config.publisher !== undefined && config.publisher !== false) ||
+      (config.agentId !== undefined && (typeof config.agentId !== "string" || !/^[a-zA-Z0-9_-]{1,64}$/.test(config.agentId)))) {
+    throw new Error("stella_ordinary_configuration_invalid: use agentId and publisher:false; legacy configuration is not migrated implicitly");
+  }
+  return { agentId: typeof config.agentId === "string" ? config.agentId : "main", publisher: false };
+}
+
+function result(details: Record<string, unknown>, isError = false) {
+  return { content: [{ type: "text" as const, text: JSON.stringify(details) }], details, ...(isError ? { isError: true } : {}) };
+}
+
+/** Ordinary, data-free entry. No legacy loader, provider, context engine,
+ * filesystem reader/writer, model client or automatic background task is bound.
+ * The Host's model supplies semantics; this tool only validates and labels its
+ * proposal. References remain unverified and cannot become author admission. */
+export default definePluginEntry({
+  id: "stella-core",
+  name: "Stella Core",
+  description: "Source-aware work-brief candidates alongside native OpenClaw memory and context",
+  register(api) {
+    const config = parseOrdinaryConfig(api.pluginConfig);
+    const status = () => ({
+      architecture: "ordinary-plugin", stage: "candidate-only", agentId: config.agentId,
+      publisher: false, sourceAdapter: "not_connected", authorConfirmation: false,
+      persistence: "none", modelCalls: false, legacyRuntime: "inactive",
+      memory: "host-owned", context: "host-owned", agentLoop: "host-owned",
+    });
+    api.registerTool({ contextVersion: 2, create(context: OpenClawPluginToolContext<2>) {
+      if (context.agentId !== config.agentId) return null;
+      // Capture the Host guard once. The mutable factory object cannot replace it.
+      const invocationGuard = context.assertInvocationCurrent.bind(context);
+      const check = (signal?: AbortSignal) => { invocationGuard(); signal?.throwIfAborted(); };
+      return [
+        { name: STATUS_TOOL, label: "Stella status", description: "Show Stella's active architecture and available capabilities. No model or personal files are accessed.",
+          parameters: Type.Object({}, { additionalProperties: false }),
+          async execute(_callId, parameters, signal) {
+            check(signal);
+            if (!isRecord(parameters) || Object.keys(parameters).length) return result({ status: "rejected", code: "stella_status_arguments_invalid" }, true);
+            return result(status());
+          } },
+        { name: CANDIDATE_TOOL, label: "Author intent candidate",
+          description: "Structure your proposed understanding of an author's work. Preserve unresolved questions and distinguish proposed premises from verified author intent. This returns an unconfirmed, unsaved candidate only. Evidence references are model-supplied and unverified. Never use this tool as confirmation, publication or memory saving.",
+          parameters: CANDIDATE_PARAMETERS,
+          async execute(callId, parameters, signal) {
+            check(signal);
+            let proposal: Proposal;
+            try { proposal = parseProposal(parameters); }
+            catch { return result({ status: "rejected", code: "stella_candidate_arguments_invalid" }, true); }
+            check(signal);
+            return result({ status: "candidate", code: "author_source_unavailable", toolCallId: callId,
+              proposal, evidenceStatus: "model_supplied_unverified", authorConfirmation: false,
+              publisher: false, saved: false });
+          } },
+      ];
+    } }, { names: [STATUS_TOOL, CANDIDATE_TOOL] });
+    api.registerCommand({ name: "stella-status", description: "Show Stella architecture and candidate-only limits without a model call", requireAuth: true,
+      handler: () => ({ text: JSON.stringify(status(), null, 2) }) });
+  },
+});
diff --git a/tests/ordinary-plugin.test.ts b/tests/ordinary-plugin.test.ts
new file mode 100644
index 00000000..6258ed7a
--- /dev/null
+++ b/tests/ordinary-plugin.test.ts
@@ -0,0 +1,68 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { Ajv } from "ajv";
+import plugin, { CANDIDATE_TOOL, STATUS_TOOL, parseOrdinaryConfig } from "../src/ordinary-plugin.js";
+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+
+const proposal = { topic: "Synthetic writing task", interpretation: "A proposed argument, not a confirmed conclusion",
+  proposedPremises: ["A tentative premise"], openQuestions: ["Which conclusion does the author intend?"], evidenceReferences: ["synthetic:unverified"] };
+function fixture() {
+  let factory: any, command: any, guardCalls = 0, active = true;
+  plugin.register!({ pluginConfig: { agentId: "main", publisher: false },
+    registerTool(value: unknown) { factory = value; }, registerCommand(value: unknown) { command = value; },
+  } as unknown as OpenClawPluginApi);
+  const context = { agentId: "main", assertInvocationCurrent() { guardCalls++; if (!active) throw Error("closed"); } };
+  const tools = factory.create(context);
+  return { tools, factory, context, command, close() { active = false; }, guards: () => guardCalls };
+}
+
+test("default package is ordinary and historical config is rejected without importing old runtime", async () => {
+  const pkg = JSON.parse(await readFile("package.json", "utf8"));
+  assert.equal(pkg.main, "./dist/src/ordinary-plugin.js"); assert.deepEqual(pkg.openclaw.extensions, [pkg.main]);
+  const manifest = JSON.parse(await readFile("openclaw.plugin.json", "utf8"));
+  assert.equal(manifest.kind, undefined); assert.equal(manifest.providers, undefined);
+  const validate = new Ajv({ strict: false }).compile(manifest.configSchema);
+  assert.equal(validate({ agentId: "main", publisher: false }), true);
+  for (const config of [{ publisher: true }, { canghaiRoot: "/synthetic" }, { agentId: "" }]) {
+    assert.equal(validate(config), false); assert.throws(() => parseOrdinaryConfig(config));
+  }
+  assert.deepEqual(parseOrdinaryConfig({}), { agentId: "main", publisher: false });
+  assert.deepEqual(Object.keys(manifest.toolMetadata).sort(), [CANDIDATE_TOOL, STATUS_TOOL].sort());
+});
+
+test("registration only contributes guarded ordinary tools and a no-model command", async () => {
+  const f = fixture();
+  assert.equal(f.factory.contextVersion, 2); assert.equal(f.factory.create({ agentId: "other" }), null);
+  assert.equal(f.command.requireAuth, true);
+  const status = await f.tools.find((t: any) => t.name === STATUS_TOOL).execute("status", {});
+  assert.equal(status.details.publisher, false); assert.equal(status.details.legacyRuntime, "inactive");
+  assert.equal(status.details.memory, "host-owned"); assert.equal(status.details.context, "host-owned");
+  assert.equal(JSON.parse(f.command.handler().text).modelCalls, false);
+});
+
+test("real tool contract returns an unsaved candidate, retaining open questions and unverified evidence", async () => {
+  const f = fixture(), tool = f.tools.find((t: any) => t.name === CANDIDATE_TOOL);
+  const result = await tool.execute("synthetic-call", proposal);
+  assert.equal(result.details.status, "candidate"); assert.equal(result.details.saved, false);
+  assert.equal(result.details.authorConfirmation, false); assert.equal(result.details.publisher, false);
+  assert.equal(result.details.evidenceStatus, "model_supplied_unverified");
+  assert.deepEqual(result.details.proposal, proposal); assert.equal(f.guards(), 2);
+  result.details.proposal.openQuestions.push("mutated"); assert.equal(proposal.openQuestions.length, 1);
+});
+
+test("spoofed confirmation, missing fields and oversized input are rejected", async () => {
+  const tool = fixture().tools.find((t: any) => t.name === CANDIDATE_TOOL);
+  for (const input of [{ ...proposal, confirmed: true }, {}, { ...proposal, interpretation: "x".repeat(4001) },
+    { ...proposal, evidenceReferences: Array(17).fill("x") }]) {
+    const result = await tool.execute("invalid", input); assert.equal(result.isError, true); assert.equal(result.details.status, "rejected");
+  }
+});
+
+test("closed invocation, replaced guard and cancellation cannot return a candidate", async () => {
+  const f = fixture(), tool = f.tools.find((t: any) => t.name === CANDIDATE_TOOL);
+  f.close(); f.context.assertInvocationCurrent = () => {};
+  await assert.rejects(tool.execute("closed", proposal), /closed/);
+  const signal = AbortSignal.abort(Error("cancelled"));
+  await assert.rejects(fixture().tools[1].execute("cancelled", proposal, signal), /cancelled/);
+});

+{
+  "id": "stella-core",
+  "name": "Stella Core",
+  "providers": [
+    "stella-guarded"
+  ],
+  "description": "Stella 3.0 cognitive runtime: Personal Twin, Framework Runtime, Reality Intelligence, and Praxis Loop",
+  "contracts": {
+    "tools": [
+      "stella_initialize",
+      "stella_read_fragment",
+      "stella_memory_data",
+      "stella_memory_correct"
+    ]
+  },
+  "activation": {
+    "onStartup": true,
+    "onAgentHarnesses": [
+      "openclaw"
+    ]
+  },
+  "configSchema": {
+    "type": "object",
+    "additionalProperties": false,
+    "required": [
+      "canghaiRoot",
+      "dataMode"
+    ],
+    "properties": {
+      "initializationGatewayAccess": {
+        "type": "string",
+        "enum": [
+          "local_operator_read"
+        ],
+        "description": "Explicit permission to verify initialization through the local authenticated Gateway using operator.read; credentials remain in Host configuration."
+      },
+      "canghaiRoot": {
+        "type": "string",
+        "minLength": 1,
+        "description": "Absolute path to the local CangHai checkout"
+      },
+      "manifestPath": {
+        "type": "string",
+        "default": "50_PersonalAgent/stella/manifest.yaml",
+        "description": "Path to the Stella consciousness manifest relative to CangHai root"
+      },
+      "recoveryRevision": {
+        "type": "string",
+        "pattern": "^[0-9a-fA-F]{40}$",
+        "description": "Exact clean CangHai Git commit selected as the recovery revision"
+      },
+      "agentId": {
+        "type": "string",
+        "default": "stella",
+        "description": "OpenClaw agent id that Stella Core should augment"
+      },
+      "dataMode": {
+        "type": "string",
+        "enum": [
+          "read_only",
+          "local_write",
+          "managed_durable_write"
+        ],
+        "description": "Explicit CangHai data mode"
+      },
+      "durabilityRemote": {
+        "type": "string",
+        "minLength": 1,
+        "description": "Explicit Git remote used only by managed_durable_write"
+      },
+      "durabilityBranch": {
+        "type": "string",
+        "minLength": 1,
+        "description": "Explicit Git branch used only by managed_durable_write"
+      },
+      "archiveRetention": {
+        "type": "string",
+        "enum": [
+          "hold_and_monitor"
+        ],
+        "description": "Opt in to native-maintenance hold checks and continuous archive backlog monitoring for the configured agent; requires session.maintenance.mode=warn and managed durability. Does not authorize deletion or certify all historical generations."
+      },
+      "contextHistorySignerId": {
+        "type": "string",
+        "pattern": "^sha256:[a-f0-9]{64}$",
+        "description": "Pinned Ed25519 public key identity for Core history; initialize the private key outside CangHai before enabling managed context."
+      },
+      "contextHistoryArchiveRoot": {
+        "type": "string",
+        "minLength": 1,
+        "description": "Repository-relative retained Core context archive directory; requires managed durable writes and a pinned signing key."
+      },
+      "recoveryAuthority": {
+        "type": "string",
+        "enum": [
+          "legacy_config",

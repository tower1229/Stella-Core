+name: Ordinary plugin package contract
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  ordinary-package:
+    name: Packaged ordinary plugin (synthetic, no Host)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .nvmrc
+          cache: npm
+      - run: npm ci
+      - run: npm run check && npm run check:schemas
+      - name: Compile source and existing tests
+        run: node scripts/compile.mjs build && node scripts/compile.mjs test
+      - name: Pack and stage the current ordinary entry
+        run: |
+          mkdir -p .artifacts/ordinary-package
+          touch .artifacts/ordinary-package/npm-user.conf .artifacts/ordinary-package/npm-global.conf
+          npm pack --json --ignore-scripts --offline --cache .artifacts/ordinary-package/npm-cache --userconfig "$PWD/.artifacts/ordinary-package/npm-user.conf" --globalconfig "$PWD/.artifacts/ordinary-package/npm-global.conf" --pack-destination .artifacts/ordinary-package > .artifacts/ordinary-package/pack.json
+          node scripts/prepare-ordinary-package-tests.mjs
+      - name: Test extracted package with synthetic sources
+        shell: bash
+        env:
+          HOME: ${{ github.workspace }}/.artifacts/ordinary-package/run/home
+          TMPDIR: ${{ github.workspace }}/.artifacts/ordinary-package/run/tmp
+          OPENCLAW_STATE_DIR: ${{ github.workspace }}/.artifacts/ordinary-package/run/home/state
+          OPENCLAW_CONFIG_PATH: ${{ github.workspace }}/.artifacts/ordinary-package/run/home/config.json
+          GIT_CONFIG_NOSYSTEM: "1"
+          GIT_CONFIG_GLOBAL: /dev/null
+          GIT_ALLOW_PROTOCOL: file
+          GIT_TERMINAL_PROMPT: "0"
+        run: |
+          cd .artifacts/ordinary-package/run/package
+          env -i PATH="$PATH" HOME="$HOME" TMPDIR="$TMPDIR" OPENCLAW_STATE_DIR="$OPENCLAW_STATE_DIR" OPENCLAW_CONFIG_PATH="$OPENCLAW_CONFIG_PATH" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_ALLOW_PROTOCOL=file GIT_TERMINAL_PROMPT=0 node --test --test-timeout=30000 ../harness/tests/*.test.js > ../test.stdout 2> ../test.stderr
+      - name: Preserve package identity and test results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: ordinary-package-contract
+          path: |
+            .artifacts/ordinary-package/PREPARED.json
+            .artifacts/ordinary-package/pack.json
+            .artifacts/ordinary-package/*.tgz
+            .artifacts/ordinary-package/run/test.stdout
+            .artifacts/ordinary-package/run/test.stderr
+          if-no-files-found: error
+      - name: Explain the limited verdict
+        if: always()
+        run: |
+          echo 'Extracted-package contracts and public skill discovery only; no live Gateway, model semantics, private data, fresh dependency install or full_memory acceptance.' >> "$GITHUB_STEP_SUMMARY"
+          echo 'Full capability assessment and Experimental owner chat keep their complete test sets and independent failed/incomplete verdicts.' >> "$GITHUB_STEP_SUMMARY"
diff --git a/scripts/prepare-ordinary-package-tests.mjs b/scripts/prepare-ordinary-package-tests.mjs

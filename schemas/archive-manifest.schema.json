{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stella.example/schemas/archive-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "stella.archive-manifest/v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upstreamId",
          "textSha256",
          "attachments"
        ],
        "properties": {
          "upstreamId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "textSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unavailable": {
            "type": "boolean"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "upstreamId",
                "sha256"
              ],
              "properties": {
                "upstreamId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unavailable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}

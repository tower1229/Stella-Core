{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stella.local/schemas/praxis-episode.schema.json",
  "title": "Stella Praxis Episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "createdAt", "updatedAt", "provenance", "situation"],
  "properties": {
    "schemaVersion": {"const": "stella.praxis-episode/v1"},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "acted", "observing", "closed", "abandoned", "expired"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentId": {"type": "string"},
        "sessionId": {"type": "string"},
        "runId": {"type": "string"},
        "messageRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "domains", "observations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "actors": {"type": "array", "items": {"type": "string"}},
        "observations": {"type": "array", "items": {"type": "string"}},
        "interpretations": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "goals": {"type": "array", "items": {"type": "string"}},
        "stakes": {"enum": ["low", "medium", "high"]},
        "reversibility": {"enum": ["high", "medium", "low"]}
      }
    },
    "twin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypothesisRefs": {"type": "array", "items": {"type": "string"}},
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "possibleActions": {
              "type": "object",
              "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "likelyInterpretations": {"type": "array", "items": {"type": "string"}},
            "keyFactors": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameworkRefs": {"type": "array", "items": {"type": "string"}},
        "operatorRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["base_model", "personal_praxis", "external_research"]}},
        "norms": {"type": "array", "items": {"type": "string"}},
        "hiddenVariables": {"type": "array", "items": {"type": "string"}},
        "likelyInterpretations": {"type": "array", "items": {"type": "string"}},
        "socialCosts": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "externalRefs": {"type": "array", "items": {"type": "string"}},
        "similarEpisodeRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {"type": "array", "items": {"type": "string"}},
        "recommendation": {"type": "string"},
        "rationale": {"type": "array", "items": {"type": "string"}},
        "actionGate": {"enum": ["A", "B", "C", "D"]}
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string"},
        "occurredAt": {"type": "string", "format": "date-time"},
        "source": {"enum": ["user_report", "tool_observation", "system_event", "inferred"]}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {"type": "array", "items": {"type": "string"}},
        "result": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "retrospective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endorsement": {"type": "number", "minimum": 0, "maximum": 1},
        "regret": {"type": "number", "minimum": 0, "maximum": 1},
        "comment": {"type": "string"},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithmVersion": {"const": "stella.praxis-learning/v1"},
        "predictionAssessment": {"enum": ["supported", "countered", "unresolved"]},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "twin": {"type": "array", "items": {"type": "string"}},
        "reality": {"type": "array", "items": {"type": "string"}},
        "praxis": {"type": "array", "items": {"type": "string"}},
        "frameworkPractice": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

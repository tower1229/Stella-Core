{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stella-core.dev/schemas/consciousness-manifest.schema.json",
  "title": "Stella Consciousness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instance",
    "sourceBaseline",
    "compatibility",
    "identity",
    "twin",
    "frameworks",
    "praxis",
    "experience",
    "derived"
  ],
  "properties": {
    "schemaVersion": {"const": "stella.consciousness-manifest/v1"},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerRef"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ownerRef": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1}
      }
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "capturedAt": {"type": "string", "format": "date-time"},
        "validationPolicy": {
          "enum": ["exact_commit", "exact_commit_and_pinned_source_blobs"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stellaCore", "openclaw"],
      "properties": {
        "stellaCore": {"type": "string", "minLength": 1},
        "openclaw": {"type": "string", "minLength": 1},
        "modelPolicyRef": {"type": "string", "minLength": 1}
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationStatus"],
      "properties": {
        "activationStatus": {"enum": ["active", "migration_required", "degraded"]},
        "observedOpenClawConfigVersion": {"type": "string", "minLength": 1},
        "observedOpenClawConfigBlobSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "requiredOpenClawVersion": {"type": "string", "minLength": 1},
        "runtimeProfileRef": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soulRef", "runtimeProfileRef"],
      "properties": {
        "soulRef": {"type": "string", "minLength": 1},
        "identityRef": {"type": "string", "minLength": 1},
        "userProfileRef": {"type": "string", "minLength": 1},
        "runtimeProfileRef": {"type": "string", "minLength": 1},
        "projectionOnlyRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "twin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesisRegistryRef"],
      "properties": {
        "hypothesisRegistryRef": {"type": "string", "minLength": 1},
        "contextualSelfRegistryRef": {"type": "string", "minLength": 1},
        "durableStateRef": {"type": "string", "minLength": 1},
        "authorityClass": {"enum": ["derived_falsifiable_model"]}
      }
    },
    "frameworks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRegistryRef", "activeIrRegistryRef"],
      "properties": {
        "sourceRegistryRef": {"type": "string", "minLength": 1},
        "activeIrRegistryRef": {"type": "string", "minLength": 1}
      }
    },
    "praxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodeRootRef"],
      "properties": {
        "episodeRootRef": {"type": "string", "minLength": 1},
        "playbookRegistryRef": {"type": "string", "minLength": 1},
        "openEpisodeRegistryRef": {"type": "string", "minLength": 1}
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusRegistryRef"],
      "properties": {
        "corpusRegistryRef": {"type": "string", "minLength": 1}
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillRegistryRef": {"type": "string", "minLength": 1},
        "capabilityPolicyRef": {"type": "string", "minLength": 1},
        "customToolRegistryRef": {"type": "string", "minLength": 1}
      }
    },
    "durableState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goalsRef": {"type": "string", "minLength": 1},
        "commitmentsRef": {"type": "string", "minLength": 1},
        "openLoopsRef": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continuitySuiteRef": {"type": "string", "minLength": 1},
        "twinEvaluationRef": {"type": "string", "minLength": 1},
        "praxisEvaluationRef": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentExplicitUserStatementPrecedence": {"type": "boolean"},
        "derivedRuntimeMayWriteAuthority": {"type": "boolean"},
        "sourceUsagePolicyRequiredBeforeDerivation": {"type": "boolean"}
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rebuild"],
      "properties": {
        "rebuild": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bootstrap_projection",
              "memory_index",
              "vector_index",
              "embeddings",
              "memory_wiki",
              "framework_registry",
              "praxis_index"
            ]
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criticalWritePolicy": {"enum": ["sync_immediately", "bounded_batch"]},
        "normalWritePolicy": {"enum": ["sync_immediately", "bounded_batch"]},
        "maxNormalRpoSeconds": {"type": "integer", "minimum": 0}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stella.local/schemas/framework-ir.schema.json",
  "title": "Stella Framework IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "source", "compiler", "cognitiveJobs", "detection", "operators", "failureModes", "compiledAt"],
  "properties": {
    "schemaVersion": {"const": "stella.framework-ir/v1"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "contentHash"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "contentHash": {"type": "string", "minLength": 8},
        "sourceVersion": {"type": "string"},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "branch": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
          }
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string"},
        "promptHash": {"type": "string", "minLength": 8}
      }
    },
    "cognitiveJobs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveSignals"],
      "properties": {
        "positiveSignals": {"type": "array", "items": {"type": "string"}},
        "negativeSignals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "questions": {"type": "array", "items": {"type": "string"}},
          "transforms": {"type": "array", "items": {"type": "string"}},
          "outputHints": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "mitigation": {"type": "string"}
        }
      }
    },
    "actionTranslation": {"type": "array", "items": {"type": "string"}},
    "domainHints": {"type": "array", "items": {"type": "string"}},
    "exampleRefs": {"type": "array", "items": {"type": "string"}},
    "compiledAt": {"type": "string", "format": "date-time"},
    "activatedAt": {"type": "string", "format": "date-time"}
  }
}
